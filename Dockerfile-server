# Production image: application code only, on top of the dependency base image.
# BASE_IMAGE can point at a mirror or at an existing server image that already
# contains the dependencies (e.g. ghcr.nju.edu.cn/xinnan-tech/xiaozhi-esp32-server:server_latest).
ARG BASE_IMAGE=ghcr.io/xinnan-tech/xiaozhi-esp32-server:server-base
FROM ${BASE_IMAGE}

COPY main/xiaozhi-server .

# Start the application
CMD ["python", "app.py"]
